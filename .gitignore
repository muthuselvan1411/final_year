# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Compiled eBPF and C build artifacts
*.o
*.obj
*.so
*.a
*.out
/ebpf/sensor_loader

# Generated build directories
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.bak

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Research data and large files (never commit raw data or weights)
data/raw/
!data/raw/.gitkeep
*.parquet
*.h5
*.feather
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.bin

# Experiment runs and outputs (track README only)
results/*
!results/README.md
runs/*
!runs/README.md
